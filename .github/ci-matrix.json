{
  "_comment": "CI matrices. Pull requests skip the macOS arm64 pool (two cancellations in one day); pushes to main and manual runs get the full set. Consumed by the scope job in ci.yml.",
  "unit": {
    "all": ["ubuntu-latest", "windows-latest", "macos-latest"],
    "pr": ["ubuntu-latest", "windows-latest"]
  },
  "binary": {
    "all": [
      { "os": "ubuntu-latest", "platform": "linux-x64", "asset": "rtk-x86_64-unknown-linux-musl.tar.gz", "bin": "rtk", "out": "rtk-bin" },
      { "os": "ubuntu-24.04-arm", "platform": "linux-arm64", "asset": "rtk-aarch64-unknown-linux-gnu.tar.gz", "bin": "rtk", "out": "rtk-bin" },
      { "os": "macos-15-intel", "platform": "darwin-x64", "asset": "rtk-x86_64-apple-darwin.tar.gz", "bin": "rtk", "out": "rtk-bin" },
      { "os": "macos-latest", "platform": "darwin-arm64", "asset": "rtk-aarch64-apple-darwin.tar.gz", "bin": "rtk", "out": "rtk-bin" },
      { "os": "windows-latest", "platform": "win32-x64", "asset": "rtk-x86_64-pc-windows-msvc.zip", "bin": "rtk.exe", "out": "rtk-bin.exe" }
    ],
    "pr": [
      { "os": "ubuntu-latest", "platform": "linux-x64", "asset": "rtk-x86_64-unknown-linux-musl.tar.gz", "bin": "rtk", "out": "rtk-bin" },
      { "os": "ubuntu-24.04-arm", "platform": "linux-arm64", "asset": "rtk-aarch64-unknown-linux-gnu.tar.gz", "bin": "rtk", "out": "rtk-bin" },
      { "os": "macos-15-intel", "platform": "darwin-x64", "asset": "rtk-x86_64-apple-darwin.tar.gz", "bin": "rtk", "out": "rtk-bin" },
      { "os": "windows-latest", "platform": "win32-x64", "asset": "rtk-x86_64-pc-windows-msvc.zip", "bin": "rtk.exe", "out": "rtk-bin.exe" }
    ]
  }
}
