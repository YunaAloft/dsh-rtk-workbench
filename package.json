{
  "name": "dsh-rtk-workbench",
  "version": "1.1.0",
  "description": "Cuts tool-output tokens in DeepSeek Harness: command rewriting, rtk-powered output compression and a prompt section, with rtk bundled.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs/reference.md",
    "docs/reference.zh.md",
    "docs/compatibility.md",
    "docs/compatibility.zh.md",
    "docs/benchmark.md",
    "docs/benchmark.zh.md",
    "CHANGELOG.md",
    "locale/*.json",
    "icon.svg",
    "README.en.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "prepare": "tsdown",
    "verify:host": "node scripts/verify-host.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "vendor": "node scripts/build-vendor.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1 <0.2.0 || >=0.1.5-alpha.1 <0.2.0 || >=0.1.6-0 <0.2.0 || >=0.1.7-0 <0.2.0 || >=0.2.0-0 <0.3.0 || >=0.2.1-0 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.20.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1 <0.2.0 || >=0.1.5-alpha.1 <0.2.0 || >=0.1.6-0 <0.2.0 || >=0.1.7-0 <0.2.0 || >=0.2.0-0 <0.3.0 || >=0.2.1-0 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-chat"]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-0 <0.3.0"
  },
  "packageManager": "pnpm@11.7.0",
  "license": "Apache-2.0",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "rtk",
    "token",
    "compression"
  ],
  "dshTarget": "0.2.2-rc.1",
  "dshRtkVersion": "1.2.0",
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunaAloft/dsh-rtk-workbench.git"
  },
  "homepage": "https://github.com/YunaAloft/dsh-rtk-workbench#readme",
  "bugs": {
    "url": "https://github.com/YunaAloft/dsh-rtk-workbench/issues"
  }
}
